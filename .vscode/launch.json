{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Equipment Monitor (API + dashboard)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/EquipmentMonitor.Api/bin/Debug/net10.0/EquipmentMonitor.Api.dll",
      "cwd": "${workspaceFolder}/src/EquipmentMonitor.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5120"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      },
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
